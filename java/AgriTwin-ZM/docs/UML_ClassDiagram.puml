@startuml AgriTwin-ZM_v1.0
' --------------------------------------------------------------
'  AgriTwin-ZM v1.0 -- Class Diagram
'  Author: BIT 213 / BSC 120 -- University of Lusaka
' --------------------------------------------------------------

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

package "agritwin" {

    class Main {
        +{static} main(args : String[]) : void
        -{static} hasFlag(args : String[], flag : String) : boolean
        -{static} launchGui(args : String[]) : void
    }

    class TestRunner {
        -{static} passed : int
        -{static} failed : int
        +{static} main(args : String[]) : void
    }
}

package "agritwin.model" {

    class Maize {
        -productionVolume : double
        -storageCapacity : double
        -moistureLevel : double
        -pricePerTon : double
        -lossPercentagePerMonth : double
        +Maize()
        +Maize(production, storage, moisture, price, lossPct)
        +getters / setters
        +toString() : String
    }

    class Tomato {
        -productionVolume : double
        -shelfLifeDays : int
        -storageType : String
        -spoilageRate : double
        -marketPricePerCrate : double
        +Tomato()
        +Tomato(production, shelfLife, storageType, spoilage, price)
        +getters / setters
        +toString() : String
    }

    class SimulationRecord {
        -monthNumber : int
        -commodityName : String
        -production : double
        -demand : double
        -surplusOrShortage : double
        -waste : double
        -revenue : double
        -foodSecurityIndicator : double
        -policyAlerts : String
        +toCsvLine() : String
        +{static} fromCsvLine(line : String) : SimulationRecord
        +toString() : String
    }
}

package "agritwin.service" {

    class SupplyDemandEngine {
        +calculateSurplus(production, demand) : double
        +calculateWaste(t : Tomato, days : int) : double
        +calculateRevenue(volumeSold, price) : double
        +adjustPrice(currentPrice, surplus, production) : double
        +adjustPrice(currentPrice, surplus) : double
        +calculateFoodSecurityIndicator(production, demand) : double
    }

    class StorageLossSimulator {
        +simulateMaizeLoss(m : Maize, months : int) : double
        +simulateTomatoSpoilage(t : Tomato, days : int) : double
    }

    class PolicyEngine {
        +{static} FRA_RESERVE_THRESHOLD : double = 500000
        +{static} EXPORT_SURPLUS_FRACTION : double = 0.20
        +{static} MAIZE_MAX_STORAGE_MONTHS : int = 6
        +checkFraReserve(stock) : String
        +checkExportRestriction(surplus, prod) : String
        +checkMaizeStorageTime(months) : String
        +checkTomatoStorageTime(days, shelfLife) : String
        +evaluateAll(...) : String
    }

    class ReportGenerator {
        +generateMonthlyReport(rec : SimulationRecord) : String
        +exportToFile(records : List<SimulationRecord>, filename : String) : void
        +exportStructured(records, path) : void
    }
}

package "agritwin.util" {

    class FileHandler {
        +saveSimulation(records : List<SimulationRecord>, path : String) : void
        +loadSimulation(path : String) : List<SimulationRecord>
    }
}

package "agritwin.ui" {

    class ConsoleUI {
        -scanner : Scanner
        -supply : SupplyDemandEngine
        -storage : StorageLossSimulator
        -policy : PolicyEngine
        -reporter : ReportGenerator
        -files : FileHandler
        -history : List<SimulationRecord>
        +start() : void
        -runMaizeSimulation() : void
        -runTomatoSimulation() : void
        -viewReports() : void
        -saveCurrentSimulation() : void
        -loadPreviousSimulation() : void
    }

    class GuiApp {
        -supply : SupplyDemandEngine
        -storage : StorageLossSimulator
        -policy : PolicyEngine
        -reporter : ReportGenerator
        -files : FileHandler
        -rows : ObservableList<RecordRow>
        +start(stage : Stage) : void
        -buildInputTab() : Tab
        -buildResultsTab() : Tab
        -buildReportsTab() : Tab
        +{static} launchApp(args : String[]) : void
    }

    class "GuiApp.RecordRow" as RecordRow {
        -monthNumber : SimpleIntegerProperty
        -commodityName : SimpleStringProperty
        -production : SimpleDoubleProperty
        -demand : SimpleDoubleProperty
        ...
        +{static} fromRecord(r : SimulationRecord) : RecordRow
        +toRecord() : SimulationRecord
    }
}

' ------------------ relationships ------------------

Main --> ConsoleUI : creates
Main ..> GuiApp : reflectively launches\n(--gui)

ConsoleUI --> SupplyDemandEngine
ConsoleUI --> StorageLossSimulator
ConsoleUI --> PolicyEngine
ConsoleUI --> ReportGenerator
ConsoleUI --> FileHandler
ConsoleUI o-- "0..*" SimulationRecord : history

GuiApp --> SupplyDemandEngine
GuiApp --> StorageLossSimulator
GuiApp --> PolicyEngine
GuiApp --> ReportGenerator
GuiApp --> FileHandler
GuiApp +-- RecordRow

ReportGenerator ..> FileHandler : delegates structured export
ReportGenerator --> SimulationRecord

SupplyDemandEngine ..> Tomato
StorageLossSimulator ..> Maize
StorageLossSimulator ..> Tomato

FileHandler --> SimulationRecord : reads / writes

TestRunner ..> SupplyDemandEngine
TestRunner ..> StorageLossSimulator
TestRunner ..> PolicyEngine
TestRunner ..> FileHandler
TestRunner ..> SimulationRecord

@enduml
